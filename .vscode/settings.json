{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.configurePreset": "debug",
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/debug",
    "--clang-tidy=false",
    "--header-insertion=never",
    "--fallback-flags=-std=c++23"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.formatting": "disabled",
  "clang-format.executable": "${env.LOCALAPPDATA}/mise/shims/clang-format.exe",
  "clang-format.style": "file",
  "clang-tidy.executable": "${env.LOCALAPPDATA}/mise/shims/clang-tidy.exe",
  "clang-tidy.buildPath": "${workspaceFolder}",
  "clang-tidy.lintOnSave": true,
  "files.associations": { "*.h": "cpp" },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  }
}
